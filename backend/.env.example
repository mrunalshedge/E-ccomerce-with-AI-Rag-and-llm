# Copy to backend/.env and fill in real values. Never commit .env.
# docker-compose also reads the POSTGRES_* values from this file.

APP_NAME=ShopSense
ENVIRONMENT=development

# --- PostgreSQL ---
# Local Docker: keep these defaults (docker-compose exposes Postgres on host port 5433).
# Neon cloud: use the values from your Neon connection string
#   postgresql://USER:PASSWORD@HOST/DBNAME  ->  POSTGRES_HOST=ep-xxx.region.aws.neon.tech,
#   POSTGRES_PORT=5432, POSTGRES_SSL=require. Use the direct host (without "-pooler").
POSTGRES_USER=shopsense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopsense
POSTGRES_TEST_DB=shopsense_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSL=disable
SQL_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT --- generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI ---
# Free key: https://aistudio.google.com/apikey  (the assistant is disabled without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
EMBEDDING_BACKEND=fastembed

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:5173"]

# Secret password for the demo seller/admin accounts (12+ chars; never publish it)
SEED_STAFF_PASSWORD=
